# Optional. Set to 1 once you have added real hero footage at
# public/media/hero-leaves.mp4 (and optionally .webm). Without it the hero
# runs on the procedural leaf canopy alone and never requests a video.
NEXT_PUBLIC_HERO_VIDEO=0

# Optional. Enables the Claude-powered design agent at /api/design-agent.
# Without it the designer falls back to the on-device matcher.
ANTHROPIC_API_KEY=
